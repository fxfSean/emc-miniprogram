page { background: #f7f8fa; color: #1d2925; font-size: 28rpx; }
.page { padding: 28rpx; box-sizing: border-box; }
.section-title { font-size: 34rpx; font-weight: 700; margin: 24rpx 0 18rpx; }
.muted { color: #77817d; }
.card { background: #fff; border: 1rpx solid #e3e7e5; border-radius: 12rpx; padding: 26rpx; margin-bottom: 18rpx; }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.button { background: #176b5b; color: #fff; border-radius: 10rpx; font-size: 28rpx; line-height: 80rpx; }
.button::after { border: 0; }
.button.secondary { color: #176b5b; background: #e8f2ef; }
.button.danger { color: #a23535; background: #f9eaea; }
.button.small { margin: 0; padding: 0 24rpx; line-height: 64rpx; font-size: 26rpx; }
.tag { padding: 6rpx 14rpx; border-radius: 8rpx; color: #176b5b; background: #e8f2ef; font-size: 23rpx; }
.tag.warn { color: #925d10; background: #fff2d5; }
.tag.gray { color: #687078; background: #eef0ef; }
.field { margin-bottom: 26rpx; }
.label { display: block; margin-bottom: 12rpx; color: #4e5955; }
.input, .textarea, .picker { width: 100%; box-sizing: border-box; background: #fff; border: 1rpx solid #dce1df; border-radius: 10rpx; padding: 20rpx; }
.textarea { min-height: 150rpx; }
.empty { text-align: center; color: #77817d; padding: 100rpx 24rpx; }
