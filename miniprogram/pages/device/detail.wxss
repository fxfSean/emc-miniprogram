.detail-head { padding: 28rpx 0 20rpx; }
.section-with-icon { display: flex; align-items: center; gap: 9rpx; }
.name { font-size: 42rpx; font-weight: 700; }
.number { display: block; margin-top: 12rpx; color: #77817d; }
.specs .row { padding: 16rpx 0; border-bottom: 1rpx solid #eef0ef; }
.specs .row:last-child { border: 0; }
.specs .location-row text:last-child { max-width: 72%; text-align: right; }
.description { line-height: 1.7; }
.reserve { margin-top: 34rpx; }
.icon-button { display: flex; align-items: center; justify-content: center; gap: 10rpx; }
