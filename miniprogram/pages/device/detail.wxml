<view class="page" wx:if="{{device}}">
  <view class="detail-head"><view class="row between"><text class="name">{{device.name}}</text><text class="tag {{device.status !== 'AVAILABLE' ? 'gray' : ''}}">{{device.statusText}}</text></view><text class="number">{{device.deviceNo}}</text></view>
  <view class="section-title section-with-icon"><app-icon name="information" size="27" /><text>设备信息</text></view>
  <view class="card specs"><view class="row between"><text class="muted">型号</text><text>{{device.model || '-'}}</text></view><view class="row between"><text class="muted">厂家</text><text>{{device.manufacturer || '-'}}</text></view><view class="row between"><text class="muted">具体位置</text><text>{{device.location || '-'}}</text></view><view wx:if="{{device.checkInPlace.name || device.checkInPlace.address}}" class="row between location-row"><text class="muted">地图位置</text><text>{{device.checkInPlace.name || device.checkInPlace.address}}</text></view></view>
  <view wx:if="{{device.description}}" class="card description">{{device.description}}</view>
  <button class="button reserve icon-button" disabled="{{device.status !== 'AVAILABLE'}}" bindtap="reserve"><app-icon name="calendar-check" size="28" /><text>{{device.status === 'AVAILABLE' ? '预约此设备' : '设备暂不可预约'}}</text></button>
</view>
