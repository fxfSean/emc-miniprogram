<view class="page">
  <view class="section-title">绑定实验室身份</view>
  <view class="muted intro">资料仅用于成员审核与设备预约管理。</view>
  <view class="field"><text class="label">姓名 *</text><input class="input" data-key="name" bindinput="input" placeholder="请输入真实姓名" /></view>
  <view class="field"><text class="label">学号 / 工号 *</text><input class="input" data-key="studentNo" bindinput="input" placeholder="请输入学号或工号" /></view>
  <view class="field"><text class="label">导师 *</text><input class="input" data-key="advisor" bindinput="input" placeholder="请输入导师姓名" /></view>
  <view class="field"><text class="label">手机号</text><input class="input" type="number" maxlength="11" data-key="phone" bindinput="input" placeholder="用于必要的预约联系" /></view>
  <view class="field"><text class="label">邀请码</text><input class="input" data-key="inviteCode" bindinput="input" password placeholder="如实验室已启用邀请码，请填写" /></view>
  <button class="button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交审核</button>
</view>
