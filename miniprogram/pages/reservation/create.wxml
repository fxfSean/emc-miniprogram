<view class="booking-page" wx:if="{{device}}">
  <view class="device-banner">
    <view class="device-accent"></view>
    <view class="device-copy">
      <text class="eyebrow">设备预约</text>
      <text class="device-name">{{device.name}}</text>
      <view class="device-meta"><text>编号 {{device.deviceNo}}</text><view wx:if="{{device.location}}" class="device-location"><app-icon name="location" size="21" /><text>{{device.location}}</text></view></view>
    </view>
    <text class="device-status">{{device.statusText}}</text>
  </view>

  <view class="calendar-panel">
    <view class="calendar-head">
      <view class="month-button previous" data-delta="-1" bindtap="changeMonth" aria-label="上一个月"><app-icon name="arrow-right" size="34" /></view>
      <view class="month-copy"><text class="section-kicker">选择日期</text><text class="month-title">{{calendarTitle}}</text></view>
      <view class="month-button" data-delta="1" bindtap="changeMonth" aria-label="下一个月"><app-icon name="arrow-right" size="34" /></view>
    </view>
    <view class="week-row"><text class="week-name" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
    <view class="calendar-grid">
      <view wx:for="{{calendarDays}}" wx:key="key" class="calendar-day {{item.empty ? 'empty-day' : ''}} {{item.today ? 'today' : ''}} {{item.selected ? 'selected-day' : ''}} {{item.disabled ? 'disabled-day' : ''}}" data-value="{{item.value}}" data-disabled="{{item.disabled}}" bindtap="selectDate">
        <text wx:if="{{!item.empty}}">{{item.day}}</text>
        <view wx:if="{{item.today && !item.selected}}" class="today-dot"></view>
      </view>
    </view>
  </view>

  <view class="schedule-panel">
    <view class="schedule-head">
      <view><view class="kicker-with-icon"><app-icon name="time" size="22" /><text class="section-kicker">当日时段</text></view><text class="schedule-date">{{selectedDateLabel}} · 30 分钟/格</text></view>
      <text class="selection-chip {{hasSelection ? 'active' : ''}}">{{selectionText}}</text>
    </view>
    <view class="legend">
      <view class="legend-item"><view class="legend-dot available"></view><text>空闲</text></view>
      <view class="legend-item"><view class="legend-dot occupied"></view><text>他人预约</text></view>
      <view class="legend-item"><view class="legend-dot mine"></view><text>我的预约</text></view>
      <view class="legend-item"><view class="legend-dot blocked"></view><text>维护/过期</text></view>
    </view>
    <view class="booking-rules">
      <view class="rules-heading"><text class="rules-title">预约须知</text><text class="rules-subtitle">提交前请确认</text></view>
      <view class="rule-item" wx:for="{{ruleTexts}}" wx:key="index"><text class="rule-index">0{{index + 1}}</text><text class="rule-text">{{item}}</text></view>
    </view>
    <view wx:if="{{loading}}" class="slots-loading">正在读取预约状态…</view>
    <view wx:else class="time-grid">
      <view wx:for="{{timeSlots}}" wx:key="index" class="time-slot status-{{item.status}} {{item.selected ? 'is-selected' : ''}}" data-index="{{item.index}}" bindtap="selectSlot">
        <text class="slot-time">{{item.timeText}}</text>
        <text class="slot-state">{{item.selected ? '已选择' : item.statusText}}</text>
      </view>
    </view>
    <text class="slot-tip">先点一个起始格，再点另一个空闲格，可快速选中连续时段；再次点击已选边缘可缩短。</text>
  </view>

  <view class="reason-panel">
    <view class="reason-head"><text class="section-kicker">预约信息</text><text class="required-note">必填</text></view>
    <textarea class="reason-input" maxlength="200" value="{{reason}}" bindinput="reasonInput" placeholder="请简述预约事由或实验内容" placeholder-class="reason-placeholder" />
    <view class="submit-row">
      <view class="submit-summary"><text class="summary-label">本次预约</text><text class="summary-value">{{selectedDateLabel}} {{selectionText}}</text></view>
      <button class="confirm-button" loading="{{submitting}}" disabled="{{submitting || !hasSelection}}" bindtap="submit">确认预约</button>
    </view>
  </view>

  <view wx:if="{{successVisible}}" class="success-mask" catchtap="noop" catchtouchmove="noop">
    <view class="success-sheet" catchtap="noop">
      <view class="success-icon"><app-icon name="check-circle" size="54" /></view>
      <text class="success-title">预约成功</text>
      <text class="success-copy">预约已保存，不开启微信提醒也不会影响本次预约。</text>

      <view class="success-summary">
        <text class="success-device">{{successSummary.deviceName}}</text>
        <text class="success-time">{{successSummary.dateText}} · {{successSummary.timeText}}</text>
      </view>

      <view wx:if="{{reminderAvailable}}" class="reminder-note">
        <app-icon name="notification" size="31" color="#176b5b" />
        <text>开启后，可接收本次预约开始前的微信提醒。本授权仅用于一次提醒。</text>
      </view>
      <view wx:elif="{{!subscriptionTemplatesReady}}" class="reminder-note muted-note">
        <app-icon name="notification" size="31" color="#68746f" />
        <text>正在加载微信提醒配置，请稍候。</text>
      </view>
      <view wx:else class="reminder-note muted-note">
        <app-icon name="notification" size="31" color="#68746f" />
        <text>微信提醒模板暂不可用，本次预约仍会正常保留。</text>
      </view>

      <view class="success-actions">
        <button wx:if="{{reminderAvailable}}" class="reminder-button" loading="{{reminderRequesting}}" disabled="{{reminderRequesting}}" bindtap="enableReminder">开启本次提醒</button>
        <button class="skip-button" disabled="{{reminderRequesting}}" bindtap="skipReminder">{{reminderAvailable ? '暂不开启，查看我的预约' : '查看我的预约'}}</button>
      </view>
    </view>
  </view>
</view>
