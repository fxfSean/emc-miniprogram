page { background: #eef1ef; font-family: "PingFang SC", sans-serif; }
.booking-page { padding: 24rpx 24rpx 44rpx; color: #1d2925; }
.device-banner { position: relative; display: flex; align-items: center; min-height: 136rpx; padding: 24rpx 24rpx 24rpx 34rpx; margin-bottom: 20rpx; overflow: hidden; box-sizing: border-box; background: #163f38; border-radius: 18rpx 6rpx 18rpx 6rpx; color: #fff; }
.device-accent { position: absolute; left: 0; top: 0; bottom: 0; width: 10rpx; background: #65b89e; }
.device-copy { flex: 1; min-width: 0; }
.eyebrow, .section-kicker { display: block; color: #68746f; font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; }
.device-banner .eyebrow { color: #9ed3c2; }
.device-name { display: block; margin-top: 6rpx; overflow: hidden; font-size: 36rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.device-meta { display: block; margin-top: 8rpx; color: #c4d7d1; font-size: 24rpx; }
.device-status { flex: none; margin-left: 18rpx; padding: 7rpx 14rpx; border: 1rpx solid rgba(255,255,255,.3); border-radius: 999rpx; color: #d8ebe5; font-size: 22rpx; }
.calendar-panel, .schedule-panel, .reason-panel { margin-bottom: 20rpx; padding: 24rpx; background: #fff; border: 1rpx solid #dce2df; border-radius: 14rpx; box-shadow: 0 5rpx 18rpx rgba(29, 49, 42, .05); }
.calendar-head, .schedule-head, .reason-head, .submit-row { display: flex; align-items: center; justify-content: space-between; }
.month-copy { text-align: left; }
.month-title, .schedule-date { display: block; margin-top: 5rpx; font-size: 30rpx; font-weight: 700; }
.month-button { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; background: #edf5f2; border: 1rpx solid #cdded8; border-radius: 8rpx; color: #176b5b; font-family: Georgia, serif; font-size: 48rpx; line-height: 58rpx; }
.week-row, .calendar-grid { display: flex; flex-wrap: wrap; }
.week-row { margin-top: 24rpx; border-bottom: 1rpx solid #edf0ef; }
.week-name { width: 14.285%; padding-bottom: 12rpx; box-sizing: border-box; color: #89918e; font-size: 22rpx; text-align: center; }
.calendar-grid { padding-top: 10rpx; }
.calendar-day { position: relative; display: flex; align-items: center; justify-content: center; width: 14.285%; height: 70rpx; box-sizing: border-box; border-radius: 8rpx; font-size: 26rpx; }
.calendar-day.today { color: #176b5b; font-weight: 700; }
.calendar-day.selected-day { background: #176b5b; color: #fff; font-weight: 700; }
.calendar-day.disabled-day { color: #c5cac8; }
.today-dot { position: absolute; bottom: 7rpx; width: 6rpx; height: 6rpx; border-radius: 50%; background: #176b5b; }
.selection-chip { max-width: 270rpx; padding: 8rpx 12rpx; overflow: hidden; border-radius: 6rpx; background: #f0f2f1; color: #77817d; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.selection-chip.active { background: #e6f0fa; color: #2563a6; font-weight: 600; }
.legend { display: flex; flex-wrap: wrap; gap: 12rpx 24rpx; margin: 22rpx 0 18rpx; color: #68746f; font-size: 21rpx; }
.legend-item { display: flex; align-items: center; }
.legend-dot { width: 15rpx; height: 15rpx; margin-right: 8rpx; border-radius: 3rpx; }
.legend-dot.available { background: #dcefe7; border: 1rpx solid #78aa98; }
.legend-dot.occupied { background: #f4d7d4; border: 1rpx solid #c95a52; }
.legend-dot.mine { background: #dbe9f8; border: 1rpx solid #2563a6; }
.legend-dot.blocked { background: #dde0df; border: 1rpx solid #a7adb3; }
.booking-rules { position: relative; margin: 0 0 20rpx; padding: 18rpx 20rpx 16rpx 26rpx; overflow: hidden; border: 1rpx solid #d8dedb; border-radius: 4rpx 10rpx 10rpx 4rpx; background: #f1f5f2; }
.booking-rules::before { position: absolute; top: 0; bottom: 0; left: 0; width: 7rpx; background: #176b5b; content: ""; }
.rules-heading { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 10rpx; }
.rules-title { color: #1f2926; font-size: 24rpx; font-weight: 700; }
.rules-subtitle { color: #7a8581; font-size: 19rpx; }
.rule-item { display: flex; align-items: flex-start; padding: 5rpx 0; }
.rule-index { flex: none; width: 48rpx; padding-top: 2rpx; color: #176b5b; font-family: Georgia, serif; font-size: 19rpx; font-weight: 700; letter-spacing: 1rpx; }
.rule-text { color: #38433f; font-size: 22rpx; line-height: 1.5; }
.time-grid { display: flex; flex-wrap: wrap; gap: 10rpx; }
.time-slot { display: flex; flex-direction: column; justify-content: center; width: calc(25% - 8rpx); min-height: 82rpx; padding: 9rpx 6rpx; box-sizing: border-box; border: 1rpx solid #8ab5a5; border-radius: 8rpx; background: #f6fbf8; text-align: center; }
.slot-time { font-size: 25rpx; font-weight: 700; }
.slot-state { margin-top: 3rpx; overflow: hidden; color: #557069; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.time-slot.status-OCCUPIED { border-color: #d9948f; background: #f9e5e3; color: #9e3e38; }
.time-slot.status-OCCUPIED .slot-state { color: #a64b45; }
.time-slot.status-MINE { border-color: #78a5d2; background: #e6f0fa; color: #1f588d; }
.time-slot.status-MINE .slot-state { color: #2563a6; }
.time-slot.status-PAST, .time-slot.status-BLOCKED { border-color: #c8ccca; background: repeating-linear-gradient(135deg, #eceeed 0, #eceeed 8rpx, #e4e7e5 8rpx, #e4e7e5 16rpx); color: #929996; }
.time-slot.status-PAST .slot-state, .time-slot.status-BLOCKED .slot-state { color: #969c99; }
.time-slot.is-selected { border-color: #174f82; background: #2563a6; color: #fff; box-shadow: inset 0 0 0 2rpx rgba(255,255,255,.24); }
.time-slot.is-selected .slot-state { color: #dceafa; }
.slots-loading { padding: 80rpx 20rpx; color: #77817d; text-align: center; }
.slot-tip { display: block; margin-top: 18rpx; color: #88918d; font-size: 21rpx; line-height: 1.55; }
.required-note { color: #b64a43; font-size: 22rpx; }
.reason-input { width: 100%; min-height: 160rpx; margin-top: 16rpx; padding: 20rpx; box-sizing: border-box; border: 1rpx solid #d5dcd9; border-radius: 8rpx; background: #fafbf9; font-size: 27rpx; line-height: 1.6; }
.reason-placeholder { color: #a1a8a5; }
.submit-row { align-items: flex-end; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #e7ebe9; }
.submit-summary { flex: 1; min-width: 0; padding-right: 18rpx; }
.summary-label { display: block; color: #89918e; font-size: 21rpx; }
.summary-value { display: block; margin-top: 5rpx; overflow: hidden; font-size: 25rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.confirm-button { flex: none; width: 218rpx; margin: 0; border-radius: 8rpx; background: #176b5b; color: #fff; font-size: 27rpx; line-height: 78rpx; }
.confirm-button::after { border: 0; }
.confirm-button[disabled] { background: #aeb8b4; color: #eef1ef; }
