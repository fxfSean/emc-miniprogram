<view class="page">
  <view class="hero">
    <view class="hero-heading"><app-icon name="device" size="42" color="#176b5b" /><text class="hero-title">设备预约</text></view>
    <text class="hero-sub">选择设备并查看可用时段</text>
  </view>
  <view class="search-shell">
    <view class="search row">
      <view class="search-input-wrap">
        <input value="{{keyword}}" bindfocus="onFocus" bindblur="onBlur" bindinput="onInput" bindconfirm="search" confirm-type="search" placeholder="搜索设备名称、编号或型号" />
        <view wx:if="{{keyword}}" class="search-clear" catchtap="clearSearch"><app-icon name="close-circle" size="30" color="#89918e" label="清空搜索关键词" /></view>
      </view>
      <button class="button small search-button" bindtap="search"><app-icon name="search" size="27" /><text>搜索</text></button>
    </view>
    <view wx:if="{{searchPanelVisible}}" class="search-panel" catchtap="noop">
      <block wx:if="{{keyword}}">
        <text class="search-panel-title">智能补全</text>
        <view wx:if="{{!suggestions.length}}" class="search-panel-empty">没有匹配的设备</view>
        <view class="suggestion-item" wx:for="{{suggestions}}" wx:key="_id" data-keyword="{{item.name}}" bindtap="selectSuggestion">
          <app-icon name="search" size="24" color="#77817d" />
          <view><text class="suggestion-name">{{item.name}}</text><text class="suggestion-meta">{{item.deviceNo}} · {{item.model || '型号未录入'}}</text></view>
        </view>
      </block>
      <block wx:else>
        <text class="search-panel-title">搜索历史</text>
        <view wx:if="{{!searchHistory.length}}" class="search-panel-empty">暂无搜索历史</view>
        <view class="history-item" wx:for="{{searchHistory}}" wx:key="*this" data-keyword="{{item}}" bindtap="selectHistory">
          <view class="history-content"><app-icon name="time" size="24" color="#77817d" /><text>{{item}}</text></view>
          <view class="history-delete" data-keyword="{{item}}" catchtap="deleteHistory"><app-icon name="close-circle" size="28" color="#89918e" label="删除搜索记录" /></view>
        </view>
      </block>
    </view>
  </view>
  <view wx:if="{{!loading && !devices.length}}" class="empty">暂无匹配设备</view>
  <view class="card device" wx:for="{{devices}}" wx:key="_id" data-id="{{item._id}}" bindtap="open">
    <view class="row between"><text class="device-name">{{item.name}}</text><text class="tag {{item.status !== 'AVAILABLE' ? 'gray' : ''}}">{{item.statusText}}</text></view>
    <text class="meta">{{item.deviceNo}} · {{item.model || '型号未录入'}}</text>
    <view class="meta location"><app-icon name="location" size="24" /><text>{{item.location || '位置未录入'}}</text></view>
  </view>
</view>
