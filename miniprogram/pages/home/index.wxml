<view class="page">
  <view class="hero">
    <view class="hero-heading"><app-icon name="device" size="38" color="#176b5b" /><text class="hero-title">设备预约</text></view>
    <text class="hero-sub">选择设备并查看可用时段</text>
  </view>
  <view wx:if="{{searchPanelVisible}}" class="search-mask" catchtap="hideSearchPanel"></view>
  <view class="search-shell">
    <view class="search row">
      <view class="search-input-wrap">
        <view class="search-prefix"><app-icon name="search" size="28" color="#77817d" /></view>
        <input value="{{keyword}}" bindfocus="onFocus" bindblur="onBlur" bindinput="onInput" bindconfirm="search" confirm-type="search" placeholder="搜索名称、编号、型号" />
        <view wx:if="{{keyword}}" class="search-clear" catchtap="clearSearch"><app-icon name="close-circle" size="30" color="#89918e" label="清空搜索关键词" /></view>
      </view>
      <button class="search-button" bindtap="search"><app-icon name="search" size="25" /><text>搜索</text></button>
    </view>
    <view wx:if="{{searchPanelVisible}}" class="search-panel" catchtap="noop">
      <block wx:if="{{keyword}}">
        <text class="search-panel-title">智能补全</text>
        <view wx:if="{{!suggestions.length}}" class="search-panel-empty">没有匹配的设备</view>
        <view class="suggestion-item" wx:for="{{suggestions}}" wx:key="_id" data-keyword="{{item.name}}" bindtap="selectSuggestion">
          <app-icon name="search" size="24" color="#77817d" />
          <view><text class="suggestion-name">{{item.name}}</text><text class="suggestion-meta">{{item.deviceNo}} · {{item.model || '型号未录入'}}</text></view>
        </view>
      </block>
      <block wx:else>
        <text class="search-panel-title">搜索历史</text>
        <view wx:if="{{!searchHistory.length}}" class="search-panel-empty">暂无搜索历史</view>
        <view class="history-item" wx:for="{{searchHistory}}" wx:key="*this" data-keyword="{{item}}" bindtap="selectHistory">
          <view class="history-content"><app-icon name="time" size="24" color="#77817d" /><text>{{item}}</text></view>
          <view class="history-delete" data-keyword="{{item}}" catchtap="deleteHistory"><app-icon name="close-circle" size="28" color="#89918e" label="删除搜索记录" /></view>
        </view>
        <block wx:if="{{quickLocations.length}}">
          <text class="search-panel-title quick-title">实验室地点</text>
          <view class="quick-locations">
            <view class="quick-location" wx:for="{{quickLocations}}" wx:key="*this" data-keyword="{{item}}" bindtap="selectQuickLocation">
              <app-icon name="location" size="22" color="#176b5b" /><text>{{item}}</text>
            </view>
          </view>
        </block>
        <block wx:if="{{quickFeatures.length}}">
          <text class="search-panel-title quick-title">设备类型</text>
          <view class="quick-features">
            <view class="quick-feature" wx:for="{{quickFeatures}}" wx:key="id" data-id="{{item.id}}" bindtap="selectQuickFeature">
              <text>{{item.label}}</text><text class="quick-count">{{item.count}}</text>
            </view>
          </view>
        </block>
      </block>
    </view>
  </view>
  <view wx:if="{{!loading && !devices.length}}" class="empty">暂无匹配设备</view>
  <view class="card device" wx:for="{{devices}}" wx:key="_id" data-id="{{item._id}}" bindtap="open">
    <view class="row between"><text class="device-name">{{item.name}}</text><text class="tag device-status {{item.status !== 'AVAILABLE' ? 'gray' : ''}}">{{item.statusText}}</text></view>
    <text class="meta device-meta">编号 {{item.deviceNo}} · {{item.model || '型号未录入'}}</text>
    <view class="device-footer">
      <view class="meta location"><app-icon name="location" size="24" /><text>{{item.location || '位置未录入'}}</text></view>
      <view wx:if="{{item.status === 'AVAILABLE'}}" class="quick-reserve" data-id="{{item._id}}" catchtap="quickReserve" aria-role="button" aria-label="预约{{item.name}}"><text>立即预约</text><app-icon name="arrow-right" size="21" color="#176b5b" /></view>
    </view>
  </view>
</view>
