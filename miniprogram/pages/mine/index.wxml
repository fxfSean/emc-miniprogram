<view class="mine-page">
  <view class="identity-panel">
    <view class="identity-decoration"></view>
    <text class="identity-kicker">MEMBER PROFILE</text>
    <view class="identity-main">
      <view class="profile-badge">{{profileInitial}}</view>
      <view class="identity-copy">
        <text class="profile-name">{{user.name}}</text>
        <text class="profile-meta">{{user.studentNo}} · {{user.advisor}}</text>
      </view>
    </view>
    <text class="role-tag">{{roleLabel}}</text>
  </view>

  <view class="section-kicker">常用功能</view>
  <view class="reservation-entry" hover-class="entry-hover-dark" bindtap="reservations">
    <view class="reservation-icon"><app-icon name="calendar-check" size="42" label="我的预约" /></view>
    <view class="entry-copy">
      <text class="reservation-title">我的预约</text>
      <text class="reservation-description">查看待使用、使用中及历史预约</text>
    </view>
    <view class="entry-action"><text>查看</text><app-icon name="arrow-right" size="30" /></view>
  </view>

  <view class="section-kicker service-label">服务与设置</view>
  <view class="menu-group">
    <view class="menu-row" hover-class="entry-hover" bindtap="messages">
      <view class="menu-icon"><app-icon name="notification" size="31" label="消息通知" /></view>
      <view class="menu-copy">
        <text class="menu-title">消息通知</text>
        <text class="menu-description">{{notification.latestTitle}}</text>
      </view>
      <text wx:if="{{notification.unreadCount}}" class="unread-count">{{notification.unreadCount > 99 ? '99+' : notification.unreadCount}}</text>
      <app-icon name="arrow-right" size="32" color="#89918e" />
    </view>
    <view class="menu-row" hover-class="entry-hover" bindtap="editProfile">
      <view class="menu-icon"><app-icon name="edit" size="31" label="编辑资料" /></view>
      <view class="menu-copy"><text class="menu-title">个人资料</text><text class="menu-description">更新身份与联系方式</text></view>
      <app-icon name="arrow-right" size="32" color="#89918e" />
    </view>
    <view wx:if="{{user.role === 'ADMIN'}}" class="menu-row" hover-class="entry-hover" bindtap="admin">
      <view class="menu-icon admin-icon"><app-icon name="settings" size="31" label="管理中心" /></view>
      <view class="menu-copy"><text class="menu-title">管理中心</text><text class="menu-description">用户、设备与预约管理</text></view>
      <app-icon name="arrow-right" size="32" color="#89918e" />
    </view>
    <view class="menu-row" hover-class="entry-hover" bindtap="about">
      <view class="menu-icon"><app-icon name="information" size="31" label="关于软件" /></view>
      <view class="menu-copy"><text class="menu-title">关于软件</text><text class="menu-description">隐私保护指引与版本信息</text></view>
      <app-icon name="arrow-right" size="32" color="#89918e" />
    </view>
  </view>
</view>
