<view class="page">
  <view class="profile row between"><view><text class="name">{{user.name}}</text><text class="muted identity">{{user.studentNo}} · {{user.advisor}}</text></view><button wx:if="{{user.role === 'ADMIN'}}" class="button secondary small" bindtap="admin">管理</button></view>
  <view class="tabs"><view class="tab {{tab === 'UPCOMING' ? 'active' : ''}}" data-tab="UPCOMING" bindtap="tab">待使用</view><view class="tab {{tab === 'HISTORY' ? 'active' : ''}}" data-tab="HISTORY" bindtap="tab">历史记录</view></view>
  <view wx:if="{{!reservations.length}}" class="empty">暂无预约记录</view>
  <view class="card booking" wx:for="{{reservations}}" wx:key="_id">
    <view class="row between"><text class="device-name">{{item.deviceName}}</text><text class="tag {{item.status === 'CANCELLED' ? 'gray' : ''}}">{{item.statusText}}</text></view>
    <text class="time">{{item.date}}　{{item.startTime}}–{{item.endTime}}</text>
    <text class="muted reason">{{item.reason}}</text>
    <button wx:if="{{item.canCancel}}" class="button danger small cancel" data-id="{{item._id}}" catchtap="cancel">取消预约</button>
  </view>
</view>
