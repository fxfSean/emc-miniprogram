<view class="page">
  <button class="button add" bindtap="add">新增设备</button>
  <view wx:if="{{!devices.length && !loading}}" class="empty">暂无设备</view>
  <view class="card device-card" wx:for="{{devices}}" wx:key="_id" data-id="{{item._id}}" bindtap="edit">
    <view class="row between"><text class="name">{{item.name}}</text><text class="tag {{item.status !== 'AVAILABLE' ? 'gray' : ''}}">{{item.statusText}}</text></view>
    <text class="muted line">{{item.deviceNo}} · {{item.model || '型号未录入'}}</text>
  </view>
</view>
