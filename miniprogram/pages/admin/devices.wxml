<view class="page"><button class="button add" bindtap="add">新增设备</button><view class="card" wx:for="{{devices}}" wx:key="_id" data-id="{{item._id}}" bindtap="edit"><view class="row between"><text class="name">{{item.name}}</text><text class="tag {{item.status !== 'AVAILABLE' ? 'gray' : ''}}">{{item.statusText}}</text></view><text class="muted line">{{item.deviceNo}} · {{item.model || '型号未录入'}}</text></view><view wx:if="{{editing}}" class="mask" bindtap="close"><view class="sheet" catchtap="noop"><view class="row between"><text class="sheet-title">{{form._id ? '编辑设备' : '新增设备'}}</text><text bindtap="close">关闭</text></view><input class="input" data-key="deviceNo" value="{{form.deviceNo}}" bindinput="input" placeholder="设备编号 *"/><input class="input" data-key="name" value="{{form.name}}" bindinput="input" placeholder="设备名称 *"/><input class="input" data-key="model" value="{{form.model}}" bindinput="input" placeholder="型号"/><input class="input" data-key="manufacturer" value="{{form.manufacturer}}" bindinput="input" placeholder="厂家"/><input class="input" data-key="location" value="{{form.location}}" bindinput="input" placeholder="位置"/><picker range="{{statusNames}}" value="{{statusIndex}}" bindchange="status"><view class="picker">状态：{{statusNames[statusIndex]}}</view></picker><button class="button" bindtap="save">保存</button></view></view></view>
