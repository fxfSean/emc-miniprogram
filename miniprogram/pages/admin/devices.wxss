.add { margin-bottom: 24rpx; }
.name { font-size: 31rpx; font-weight: 700; }
.line { display: block; margin-top: 10rpx; }
.mask { position: fixed; inset: 0; background: rgba(15,25,21,.45); display: flex; align-items: flex-end; z-index: 9; }
.sheet { width: 100%; max-height: 84vh; overflow-y: auto; box-sizing: border-box; padding: 30rpx; padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 16rpx 16rpx 0 0; }
.sheet-title { font-size: 34rpx; font-weight: 700; }
.close { color: #687078; }
.sheet .input,.sheet .picker { margin-top: 20rpx; }
.form-actions { margin-top: 30rpx; }
.sheet .save-button { display: flex; align-items: center; justify-content: center; width: 100%; height: 84rpx; margin: 0; padding: 0; border-radius: 10rpx; line-height: 1; font-weight: 700; }
.delete-action-row { display: flex; justify-content: flex-end; margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid #e3e7e5; }
.delete-button { flex: none; min-width: 152rpx; height: 64rpx; margin: 0 -12rpx 0 0; padding: 0 20rpx; box-sizing: border-box; line-height: 64rpx; color: #b64a43; background: transparent; border: 0; border-radius: 8rpx; font-size: 25rpx; font-weight: 600; }
.delete-button::after { border: 0; }
.delete-button[disabled] { color: #c7908b; background: transparent; }
