<view class="page">
  <view class="directory-head">
    <text class="directory-title">注册用户</text>
    <text class="directory-desc">按姓名或学号查找，并查看审核状态</text>
    <view class="search-row">
      <view class="search-box">
        <input class="search-input" value="{{keyword}}" placeholder="搜索姓名或学号" confirm-type="search" bindinput="onKeywordInput" bindconfirm="search" />
        <text wx:if="{{keyword}}" class="clear" bindtap="clearKeyword">清除</text>
      </view>
      <button class="search-button" bindtap="search">搜索</button>
    </view>
  </view>

  <view class="status-tabs">
    <view class="status-tab {{status === 'ALL' ? 'active' : ''}}" data-status="ALL" bindtap="selectStatus"><text>全部</text><text class="tab-count">{{counts.ALL}}</text></view>
    <view class="status-tab {{status === 'PENDING' ? 'active' : ''}}" data-status="PENDING" bindtap="selectStatus"><text>待审核</text><text class="tab-count">{{counts.PENDING}}</text></view>
    <view class="status-tab {{status === 'APPROVED' ? 'active' : ''}}" data-status="APPROVED" bindtap="selectStatus"><text>已通过</text><text class="tab-count">{{counts.APPROVED}}</text></view>
    <view class="status-tab {{status === 'REJECTED' ? 'active' : ''}}" data-status="REJECTED" bindtap="selectStatus"><text>已拒绝</text><text class="tab-count">{{counts.REJECTED}}</text></view>
    <view class="status-tab {{status === 'DISABLED' ? 'active' : ''}}" data-status="DISABLED" bindtap="selectStatus"><text>已禁用</text><text class="tab-count">{{counts.DISABLED}}</text></view>
  </view>

  <view class="result-bar"><text>用户列表</text><text class="muted">共 {{users.length}} 人</text></view>
  <view wx:if="{{loading}}" class="loading">正在读取用户信息…</view>
  <view wx:elif="{{!users.length}}" class="empty">没有符合条件的用户</view>
  <view wx:else class="user-list">
    <view class="card user-card border-{{item.statusClass}}" wx:for="{{users}}" wx:key="_id">
      <view class="row between card-head">
        <view class="identity">
          <text class="name">{{item.name || '未填写姓名'}}</text>
          <text wx:if="{{item.role === 'ADMIN'}}" class="role-tag">管理员</text>
        </view>
        <text class="status-tag status-{{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="info-grid">
        <view class="info-item"><text class="info-label">学号</text><text class="info-value">{{item.studentNo || '未填写'}}</text></view>
        <view class="info-item"><text class="info-label">导师</text><text class="info-value">{{item.advisor || '未填写'}}</text></view>
        <view class="info-item info-full"><text class="info-label">手机号</text><text class="info-value">{{item.phone || '未填写'}}</text></view>
      </view>
      <view wx:if="{{item.status === 'REJECTED' && item.reviewNote}}" class="review-note"><text>拒绝原因</text><text>{{item.reviewNote}}</text></view>
      <view wx:if="{{item.status === 'PENDING'}}" class="actions">
        <button class="button danger small" data-id="{{item._id}}" disabled="{{actionUserId !== ''}}" bindtap="reject">拒绝</button>
        <button class="button small" data-id="{{item._id}}" loading="{{actionUserId === item._id}}" disabled="{{actionUserId !== ''}}" bindtap="approve">通过</button>
      </view>
      <view wx:elif="{{item.status === 'APPROVED' && item.role !== 'ADMIN'}}" class="actions">
        <button class="button danger small account-button" data-id="{{item._id}}" loading="{{actionUserId === item._id}}" disabled="{{actionUserId !== ''}}" bindtap="disableUser">禁用账号</button>
      </view>
      <view wx:elif="{{item.status === 'DISABLED'}}" class="actions">
        <button class="button small account-button" data-id="{{item._id}}" loading="{{actionUserId === item._id}}" disabled="{{actionUserId !== ''}}" bindtap="enableUser">启用账号</button>
      </view>
    </view>
  </view>
</view>
