<view class="page"><view wx:if="{{!users.length}}" class="empty">没有待审核成员</view><view class="card" wx:for="{{users}}" wx:key="_id"><view class="row between"><text class="name">{{item.name}}</text><text class="tag warn">待审核</text></view><text class="line">{{item.studentNo}} · {{item.advisor}}</text><text class="muted line">{{item.phone || '未填写手机号'}}</text><view class="actions"><button class="button secondary small" data-id="{{item._id}}" bindtap="reject">驳回</button><button class="button small" data-id="{{item._id}}" bindtap="approve">通过</button></view></view></view>
