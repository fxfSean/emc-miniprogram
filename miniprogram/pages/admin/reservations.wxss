.overview-page { min-height: 100vh; padding: 24rpx 24rpx 60rpx; box-sizing: border-box; }
.hero { margin: -24rpx -24rpx 22rpx; padding: 34rpx 28rpx 30rpx; color: #fff; background: #163d35; }
.kicker { display: block; color: #9ed3c2; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.title { display: block; margin-top: 8rpx; font-size: 42rpx; font-weight: 700; }
.subtitle { display: block; margin-top: 10rpx; color: #c4d7d1; font-size: 23rpx; }
.more::after { border: 0; }
.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 18rpx; }
.segments { display: flex; padding: 5rpx; background: #e8ecea; border-radius: 9rpx; }
.segment { padding: 12rpx 24rpx; color: #687078; font-size: 24rpx; }
.segment.active { color: #fff; background: #176b5b; border-radius: 7rpx; }
.filter { display: flex; align-items: center; max-width: 290rpx; color: #44514d; font-size: 24rpx; }
.filter-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.filter-arrow { position: relative; flex: none; width: 14rpx; height: 14rpx; margin-left: 8rpx; }
.filter-arrow::after { position: absolute; top: 3rpx; left: 1rpx; width: 0; height: 0; border-top: 8rpx solid #44514d; border-right: 6rpx solid transparent; border-left: 6rpx solid transparent; content: ''; }
.calendar { padding: 24rpx; background: #fff; border: 1rpx solid #e3e7e5; border-radius: 12rpx; }
.month-nav { display: flex; align-items: center; justify-content: space-between; padding-bottom: 20rpx; }
.month-arrow { display: flex; align-items: center; justify-content: center; padding: 10rpx 22rpx; color: #176b5b; }
.month-arrow.previous app-icon { transform: rotate(180deg); }
.month-title { font-weight: 700; }
.week,.days { display: grid; grid-template-columns: repeat(7, 1fr); }
.week text { padding: 8rpx 0 14rpx; color: #89918e; font-size: 21rpx; text-align: center; }
.day { position: relative; height: 70rpx; margin: 3rpx; box-sizing: border-box; text-align: center; line-height: 70rpx; border-radius: 8rpx; }
.day.today { box-shadow: inset 0 0 0 1rpx #176b5b; }
.day.selected { color: #fff; background: #176b5b; }
.count { position: absolute; right: 5rpx; bottom: 4rpx; min-width: 24rpx; height: 24rpx; color: #176b5b; background: #d8ebe5; border-radius: 12rpx; font-size: 16rpx; line-height: 24rpx; }
.selected .count { color: #176b5b; background: #fff; }
.list-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 28rpx 2rpx 16rpx; }
.list-date { display: block; font-size: 31rpx; font-weight: 700; }
.list-count { display: block; margin-top: 5rpx; color: #77817d; font-size: 21rpx; }
.date-action { color: #176b5b; font-size: 24rpx; }
.usage-summary { display: grid; grid-template-columns: 1fr 1fr 1.6fr; margin-bottom: 18rpx; padding: 18rpx 20rpx; background: #edf3f1; border-left: 6rpx solid #176b5b; border-radius: 8rpx; }
.usage-summary view { padding: 0 14rpx; border-right: 1rpx solid #d3ddda; }
.usage-summary view:first-child { padding-left: 0; }
.usage-summary view:last-child { padding-right: 0; border-right: 0; }
.usage-summary text:first-child { display: block; color: #176b5b; font-family: Georgia, serif; font-size: 27rpx; font-weight: 700; }
.usage-summary text:last-child { display: block; margin-top: 4rpx; color: #687078; font-size: 18rpx; }
.duration-summary { text-align: right; }
.booking { display: grid; grid-template-columns: 150rpx 1fr; margin-bottom: 14rpx; overflow: hidden; background: #fff; border: 1rpx solid #e3e7e5; border-radius: 11rpx; }
.time-rail { padding: 22rpx 14rpx; color: #176b5b; background: #f1f6f4; font-family: Georgia, serif; font-size: 22rpx; }
.rail { width: 36rpx; height: 4rpx; margin-top: 13rpx; background: #176b5b; }
.booking-main { min-width: 0; padding: 20rpx; }
.device { overflow: hidden; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.status { flex: none; margin-left: 12rpx; padding: 5rpx 10rpx; color: #176b5b; background: #e8f2ef; border-radius: 6rpx; font-size: 20rpx; }
.status.CANCELLED,.status.ENDED { color: #687078; background: #eef0ef; }
.status.IN_USE { color: #925d10; background: #fff2d5; }
.owner,.reason { display: block; margin-top: 8rpx; color: #687078; font-size: 22rpx; }
.reason { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.more { color: #176b5b; background: transparent; font-size: 24rpx; }
