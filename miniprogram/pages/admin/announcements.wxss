.announcement-page { padding-bottom: 150rpx; }
.admin-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 18rpx 2rpx 26rpx; }
.head-kicker,.head-title,.head-copy { display: block; }
.head-kicker { color: #176b5b; font: 700 19rpx Georgia, serif; letter-spacing: 3rpx; }
.head-title { margin-top: 8rpx; color: #1d2925; font-size: 42rpx; font-weight: 700; }
.head-copy { margin-top: 7rpx; color: #77817d; font-size: 22rpx; }
.settings-button { flex: none; width: 150rpx; height: 66rpx; margin: 2rpx 0 0; padding: 0; color: #176b5b; background: #e8f2ef; border-radius: 8rpx; font-size: 23rpx; line-height: 66rpx; }
.settings-button::after,.publish-fixed::after { border: 0; }
.metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-bottom: 22rpx; }
.metrics view { padding: 20rpx 12rpx; background: #fff; border: 1rpx solid #e3e7e5; border-radius: 9rpx; }
.metrics text { display: block; }
.metrics text:first-child { color: #1d2925; font: 700 34rpx Georgia, serif; }
.metrics text:last-child { margin-top: 5rpx; color: #77817d; font-size: 21rpx; }
.filters { display: flex; gap: 30rpx; height: 68rpx; margin-bottom: 22rpx; border-bottom: 1rpx solid #dce1df; }
.filters text { color: #77817d; font-size: 24rpx; line-height: 68rpx; }
.filters .active { color: #176b5b; font-weight: 700; border-bottom: 4rpx solid #176b5b; }
.announcement { display: grid; grid-template-columns: 58rpx 1fr; gap: 14rpx; margin-bottom: 18rpx; }
.announcement-number { padding-top: 22rpx; color: #176b5b; font: 700 22rpx Georgia, serif; }
.announcement-main { min-width: 0; padding: 22rpx; background: #fff; border: 1rpx solid #e3e7e5; border-radius: 10rpx; }
.announcement-title { flex: 1; min-width: 0; color: #1d2925; font-size: 28rpx; font-weight: 700; }
.status { flex: none; margin-left: 14rpx; padding: 5rpx 10rpx; color: #176b5b; background: #e8f2ef; border-radius: 6rpx; font-size: 19rpx; }
.status-DISABLED { color: #687078; background: #eef0ef; }
.announcement-content { display: block; margin-top: 14rpx; color: #5e6965; font-size: 23rpx; line-height: 1.6; }
.announcement-time { display: block; margin-top: 14rpx; color: #89918e; font: 20rpx Georgia, serif; }
.announcement-foot { display: flex; justify-content: space-between; margin-top: 16rpx; padding-top: 14rpx; color: #89918e; border-top: 1rpx solid #edf0ef; font-size: 20rpx; }
.disable { color: #b64a43; }
.publish-fixed { position: fixed; z-index: 8; right: 28rpx; bottom: 32rpx; left: 28rpx; height: 82rpx; margin: 0; padding: 0; color: #fff; background: #176b5b; border-radius: 10rpx; font-size: 27rpx; font-weight: 700; line-height: 82rpx; }
.drawer-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(15,25,21,.62); }
.drawer { width: 100%; max-height: 88vh; overflow-y: auto; padding: 30rpx 28rpx 44rpx; box-sizing: border-box; background: #fff; border-radius: 24rpx 24rpx 0 0; }
.drawer-head { display: flex; justify-content: space-between; margin-bottom: 28rpx; }
.drawer-title { display: block; margin-top: 7rpx; color: #1d2925; font-size: 34rpx; font-weight: 700; }
.close { color: #687078; font-size: 24rpx; }
.date-row { display: grid; grid-template-columns: 1.25fr .75fr; gap: 12rpx; }
.end-label { margin-top: 20rpx; }
.wechat-row { display: flex; align-items: center; justify-content: space-between; margin-top: 26rpx; padding: 20rpx; background: #f7f8fa; border-radius: 9rpx; }
.wechat-row text { display: block; color: #1d2925; font-size: 24rpx; }
.wechat-row text + text { margin-top: 5rpx; color: #77817d; font-size: 20rpx; }
.publish { margin-top: 28rpx; }
