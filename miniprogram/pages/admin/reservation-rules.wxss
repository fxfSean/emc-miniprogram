.rules-page { min-height: 100vh; padding: 24rpx 24rpx 60rpx; }
.hero { margin: -24rpx -24rpx 22rpx; padding: 34rpx 28rpx 30rpx; color: #fff; background: #163d35; }
.kicker { display: block; color: #9ed3c2; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.title { display: block; margin-top: 8rpx; font-size: 40rpx; font-weight: 700; }
.copy { display: block; margin-top: 10rpx; color: #c4d7d1; font-size: 22rpx; line-height: 1.5; }
.rule { display: grid; grid-template-columns: 58rpx 1fr 168rpx; gap: 14rpx; align-items: center; margin-bottom: 14rpx; padding: 22rpx; background: #fff; border: 1rpx solid #e3e7e5; border-radius: 10rpx; }
.rule-number { align-self: start; color: #176b5b; font-family: Georgia, serif; font-size: 21rpx; font-weight: 700; }
.label { display: block; color: #293531; font-size: 25rpx; font-weight: 700; }
.desc { display: block; margin-top: 7rpx; color: #89918e; font-size: 20rpx; line-height: 1.45; }
.value { display: flex; align-items: center; justify-content: flex-end; gap: 7rpx; }
.value input { width: 92rpx; height: 68rpx; box-sizing: border-box; color: #176b5b; background: #f1f6f4; border: 1rpx solid #cbdcd6; border-radius: 7rpx; font-family: Georgia, serif; text-align: center; }
.value text { color: #687078; font-size: 20rpx; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 32rpx 2rpx 16rpx; }
.section-heading text:first-child { color: #293531; font-size: 31rpx; font-weight: 700; }
.section-heading text:last-child { color: #89918e; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.notice { margin: 20rpx 0; padding: 20rpx 22rpx; color: #6f514d; background: #fff7f6; border-left: 6rpx solid #b64a43; font-size: 22rpx; line-height: 1.55; }
.location-notice { color: #44514d; background: #eef5f2; border-left-color: #176b5b; }
.save { display: flex; align-items: center; justify-content: center; height: 84rpx; padding: 0; line-height: 1; }
