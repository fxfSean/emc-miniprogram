<view class="proxy-page"><view class="intro"><text class="kicker">BOOK FOR MEMBER</text><text class="title">代用户预约</text><text class="copy">代预约仍遵守用户预约规则与设备冲突校验</text></view>
  <view class="section"><text class="section-title">01 选择成员</text><view class="search-row"><input class="input" value="{{keyword}}" bindinput="keywordInput" bindconfirm="searchUsers" placeholder="搜索姓名或学号"/><button bindtap="searchUsers">搜索</button></view><picker range="{{userNames}}" value="{{userIndex}}" bindchange="userChange"><view class="picker choice">{{userIndex >= 0 ? userNames[userIndex] : '请选择已通过审核的成员'}}</view></picker></view>
  <view class="section"><text class="section-title">02 设备与日期</text><picker range="{{deviceNames}}" value="{{deviceIndex}}" bindchange="deviceChange"><view class="picker choice">{{deviceIndex >= 0 ? deviceNames[deviceIndex] : '请选择可预约设备'}}</view></picker><picker mode="date" value="{{date}}" bindchange="dateChange"><view class="picker choice">预约日期：{{date}}</view></picker></view>
  <view class="section"><view class="row between"><text class="section-title">03 连续时段</text><text class="clear" bindtap="clearSelection">清除</text></view><text class="selection">{{selectionText}}</text><view wx:if="{{deviceId}}" class="slots"><view wx:for="{{slots}}" wx:key="index" class="slot {{item.status}} {{item.selected ? 'selected' : ''}}" data-index="{{item.index}}" bindtap="selectSlot"><text>{{item.startTime}}</text></view></view><view wx:else class="hint">选择设备后显示可预约时段</view></view>
  <view class="section"><text class="section-title">04 预约事由</text><textarea class="textarea" value="{{reason}}" bindinput="reasonInput" maxlength="200" placeholder="填写实验内容或预约事由"/></view>
  <button class="button submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">确认代预约</button>
</view>
