.blocks-page { min-height: 100vh; padding: 24rpx 24rpx 60rpx; }
.hero { display: flex; align-items: flex-end; justify-content: space-between; margin: -24rpx -24rpx 22rpx; padding: 34rpx 28rpx 30rpx; color: #fff; background: #163d35; }
.kicker,.sheet-kicker { display: block; color: #9ed3c2; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.title { display: block; margin-top: 8rpx; font-size: 40rpx; font-weight: 700; }
.hero button { height: 68rpx; margin: 0; padding: 0 22rpx; color: #163d35; background: #fff; line-height: 68rpx; font-size: 23rpx; }
.hero button::after,.reopen::after { border: 0; }
.filter { display: flex; align-items: center; margin-bottom: 20rpx; padding: 20rpx; color: #44514d; background: #fff; border: 1rpx solid #e3e7e5; border-radius: 9rpx; }
.filter-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.filter-arrow { position: relative; flex: none; width: 14rpx; height: 14rpx; margin-left: 8rpx; }
.filter-arrow::after { position: absolute; top: 3rpx; left: 1rpx; width: 0; height: 0; border-top: 8rpx solid #44514d; border-right: 6rpx solid transparent; border-left: 6rpx solid transparent; content: ''; }
.block-card { display: grid; grid-template-columns: 8rpx 1fr; margin-bottom: 14rpx; overflow: hidden; background: #fff; border: 1rpx solid #e3e7e5; border-radius: 10rpx; }
.stripe { background: #b64a43; }.stripe.HOLIDAY { background: #925d10; }.stripe.OTHER { background: #687078; }
.block-main { padding: 22rpx; }
.device { font-weight: 700; }.category { color: #8e5b57; font-size: 21rpx; }
.period,.reason { display: block; margin-top: 9rpx; color: #687078; font-size: 22rpx; line-height: 1.5; }
.reopen { margin: 14rpx -10rpx -8rpx auto; color: #176b5b; background: transparent; font-size: 23rpx; }
.mask { position: fixed; inset: 0; z-index: 10; display: flex; align-items: flex-end; background: rgba(15,25,21,.48); }
.sheet { width: 100%; max-height: 86vh; padding: 30rpx; padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); box-sizing: border-box; overflow-y: auto; background: #fff; border-radius: 18rpx 18rpx 0 0; }
.sheet-title { display: block; margin-top: 7rpx; font-size: 34rpx; font-weight: 700; }.close { color: #687078; }
.sheet .picker,.sheet .textarea { margin-top: 18rpx; }
.datetime { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.save { display: flex; align-items: center; justify-content: center; height: 84rpx; margin-top: 24rpx; line-height: 1; }
