<view class="blocks-page"><view class="hero"><view><text class="kicker">DEVICE AVAILABILITY</text><text class="title">禁用时段</text></view><button bindtap="add">新增时段</button></view><picker range="{{deviceNames}}" value="{{filterIndex}}" bindchange="filterChange"><view class="filter"><text class="filter-label">筛选：{{deviceNames[filterIndex]}}</text><view class="filter-arrow"></view></view></picker>
  <view wx:if="{{!blocks.length}}" class="empty">暂无维护或禁用安排</view>
  <view wx:for="{{blocks}}" wx:key="_id" class="block-card"><view class="stripe {{item.category}}"></view><view class="block-main"><view class="row between"><text class="device">{{item.deviceName}}</text><text class="category">{{categoryLabels[item.category]}}</text></view><text class="period">{{item.startText}} — {{item.endText}}</text><text class="reason">{{item.reason}}</text><button class="reopen" data-id="{{item._id}}" catchtap="remove">恢复开放</button></view></view>
  <view wx:if="{{editing}}" class="mask" bindtap="close"><view class="sheet" catchtap="noop"><view class="row between"><view><text class="sheet-kicker">BLOCK DEVICE</text><text class="sheet-title">新增禁用时段</text></view><text class="close" bindtap="close">关闭</text></view><picker range="{{selectDeviceNames}}" value="{{form.deviceIndex}}" bindchange="deviceChange"><view class="picker">{{form.deviceIndex >= 0 ? selectDeviceNames[form.deviceIndex] : '请选择设备'}}</view></picker><picker range="{{categoryNames}}" value="{{form.categoryIndex}}" bindchange="categoryChange"><view class="picker">类型：{{categoryNames[form.categoryIndex]}}</view></picker><view class="datetime"><picker mode="date" value="{{form.startDate}}" data-key="startDate" bindchange="valueChange"><view class="picker">{{form.startDate}}</view></picker><picker mode="time" value="{{form.startTime}}" data-key="startTime" bindchange="valueChange"><view class="picker">{{form.startTime}}</view></picker></view><view class="datetime"><picker mode="date" value="{{form.endDate}}" data-key="endDate" bindchange="valueChange"><view class="picker">{{form.endDate}}</view></picker><picker mode="time" value="{{form.endTime}}" data-key="endTime" bindchange="valueChange"><view class="picker">{{form.endTime}}</view></picker></view><textarea class="textarea" value="{{form.reason}}" data-key="reason" bindinput="valueChange" maxlength="100" placeholder="填写维护、假期或其他禁用原因"/><button class="button save" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存禁用时段</button></view></view>
</view>
