.settings-page { padding-bottom: 50rpx; }
.settings-head { padding: 18rpx 2rpx 28rpx; }
.head-kicker,.head-title,.head-copy { display: block; }
.head-kicker { color: #176b5b; font: 700 19rpx Georgia, serif; letter-spacing: 3rpx; }
.head-title { margin-top: 8rpx; color: #1d2925; font-size: 42rpx; font-weight: 700; }
.head-copy { margin-top: 7rpx; color: #77817d; font-size: 22rpx; }
.section-block { display: grid; grid-template-columns: 58rpx 1fr; gap: 14rpx; margin-bottom: 16rpx; padding: 22rpx; background: #fff; border: 1rpx solid #e3e7e5; border-radius: 10rpx; }
.section-number { color: #176b5b; font: 700 22rpx Georgia, serif; }
.section-main { min-width: 0; }
.section-title,.section-copy { display: block; margin: 0; }
.section-title { color: #1d2925; font-size: 28rpx; font-weight: 700; }
.section-copy { margin-top: 7rpx; color: #77817d; font-size: 21rpx; line-height: 1.5; }
.reminder-picker { margin-top: 20rpx; background: #f7f8fa; }
.template-head { margin: 34rpx 2rpx 16rpx; }
.template-head text { display: block; color: #1d2925; font-size: 30rpx; font-weight: 700; }
.template-head text + text { margin-top: 7rpx; color: #77817d; font-size: 21rpx; font-weight: 400; }
.template { margin-bottom: 16rpx; padding: 22rpx; background: #fff; border: 1rpx solid #e3e7e5; border-radius: 10rpx; }
.template-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; color: #1d2925; font-size: 25rpx; font-weight: 700; }
.template-status { padding: 5rpx 10rpx; color: #687078; background: #eef0ef; border-radius: 6rpx; font-size: 18rpx; font-weight: 400; }
.template-status.configured { color: #176b5b; background: #e8f2ef; }
.mapping { width: 100%; min-height: 110rpx; margin-top: 12rpx; padding: 18rpx; box-sizing: border-box; color: #44514d; background: #f7f8fa; border: 1rpx solid #dce1df; border-radius: 8rpx; font: 21rpx/1.55 Georgia, serif; }
.save { margin-top: 26rpx; }
