.proxy-page { padding: 24rpx 24rpx 60rpx; }
.intro { margin: -24rpx -24rpx 22rpx; padding: 34rpx 28rpx 30rpx; color: #fff; background: #163d35; }
.kicker { display: block; color: #9ed3c2; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.title { display: block; margin-top: 8rpx; font-size: 40rpx; font-weight: 700; }
.copy { display: block; margin-top: 10rpx; color: #c4d7d1; font-size: 22rpx; }
.section { margin-bottom: 18rpx; padding: 24rpx; background: #fff; border: 1rpx solid #e3e7e5; border-radius: 11rpx; }
.section-title { margin: 0 0 16rpx; color: #38433f; font-size: 24rpx; font-weight: 700; }
.search-row { display: grid; grid-template-columns: minmax(0, 1fr) 128rpx; gap: 12rpx; width: 100%; margin-top: 14rpx; }
.search-row .input { width: 100%; min-width: 0; margin: 0; box-sizing: border-box; }
.search-row button { display: flex; align-items: center; justify-content: center; width: 128rpx; min-width: 0; height: 88rpx; margin: 0; padding: 0; color: #176b5b; background: #e8f2ef; font-size: 24rpx; line-height: 1; }
.search-row button::after { border: 0; }
.choice { margin-top: 14rpx; background: #f7f8fa; }
.selection { display: block; margin-bottom: 14rpx; color: #176b5b; font-family: Georgia, serif; }
.clear { color: #687078; font-size: 22rpx; }
.slots { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; }
.slot { padding: 16rpx 4rpx; color: #176b5b; background: #f1f6f4; border: 1rpx solid #cbdcd6; border-radius: 7rpx; font-size: 21rpx; text-align: center; }
.slot.OCCUPIED,.slot.BLOCKED,.slot.PAST { color: #9aa19e; background: #eef0ef; border-color: #e0e3e2; }
.slot.selected { color: #fff; background: #176b5b; border-color: #176b5b; }
.hint { padding: 44rpx 0; color: #89918e; text-align: center; }
.submit { display: flex; align-items: center; justify-content: center; height: 84rpx; line-height: 1; }
