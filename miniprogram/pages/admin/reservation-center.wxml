<view class="reservation-center">
  <view class="center-hero">
    <text class="hero-kicker">RESERVATION CONTROL</text>
    <view class="hero-title"><app-icon name="calendar-check" size="39" /><text>预约管理</text></view>
    <text class="hero-copy">查询设备占用，或进入预约操作与规则配置</text>
  </view>

  <text class="group-title">预约数据</text>
  <view class="nav-group primary-group">
    <view class="nav-item primary-item" bindtap="records">
      <view class="nav-icon primary-icon"><app-icon name="calendar" size="36" /></view>
      <view class="nav-copy"><text class="nav-title">预约记录</text><text class="nav-description">按日历、日期和设备查询全部预约</text></view>
      <app-icon name="arrow-right" size="34" color="#89918e" />
    </view>
  </view>

  <text class="group-title operations-title">操作与配置</text>
  <view class="nav-group">
    <view class="nav-item" bindtap="create">
      <view class="nav-icon"><app-icon name="user-settings" size="34" /></view>
      <view class="nav-copy"><text class="nav-title">代用户预约</text><text class="nav-description">为实验室成员创建预约</text></view>
      <app-icon name="arrow-right" size="34" color="#89918e" />
    </view>
    <view class="nav-item" bindtap="blocks">
      <view class="nav-icon warning-icon"><app-icon name="prohibited" size="34" /></view>
      <view class="nav-copy"><text class="nav-title">禁用时段</text><text class="nav-description">维护设备停用与不可预约时间</text></view>
      <app-icon name="arrow-right" size="34" color="#89918e" />
    </view>
    <view class="nav-item" bindtap="rules">
      <view class="nav-icon"><app-icon name="settings" size="34" /></view>
      <view class="nav-copy"><text class="nav-title">规则配置</text><text class="nav-description">设置预约范围、时长和签到规则</text></view>
      <app-icon name="arrow-right" size="34" color="#89918e" />
    </view>
  </view>
</view>
