<view class="page">
  <view class="section-title section-with-icon"><app-icon name="dashboard" size="27" /><text>管理概览</text></view>
  <view class="metrics"><view class="metric"><text>{{summary.pendingUsers || 0}}</text><text class="muted">待审核成员</text></view><view class="metric"><text>{{summary.devices || 0}}</text><text class="muted">设备总数</text></view><view class="metric"><text>{{summary.todayReservations || 0}}</text><text class="muted">今日预约</text></view></view>
  <view class="section-title">管理</view>
  <view class="card menu primary-menu" bindtap="reservations"><view class="menu-icon"><app-icon name="calendar-check" size="34" /></view><view class="menu-copy"><text class="menu-title">预约管理</text><text class="menu-desc">预约总览、代预约、禁用时段与规则配置</text></view><app-icon name="arrow-right" size="34" color="#89918e" /></view>
  <view class="card menu message-menu" bindtap="notifications"><view class="menu-icon amber"><app-icon name="megaphone" size="34" /></view><view class="menu-copy"><text class="menu-title">消息与公告</text><text class="menu-desc">系统公告、预约提醒与微信模板配置</text></view><app-icon name="arrow-right" size="34" color="#89918e" /></view>
  <view class="card menu" bindtap="users"><view class="menu-icon"><app-icon name="user-shield" size="34" /></view><view class="menu-copy"><text class="menu-title">成员管理</text><text class="menu-desc">查看、搜索与审核注册用户</text></view><app-icon name="arrow-right" size="34" color="#89918e" /></view>
  <view class="card menu" bindtap="devices"><view class="menu-icon"><app-icon name="device" size="34" /></view><view class="menu-copy"><text class="menu-title">设备管理</text><text class="menu-desc">维护设备资料与可用状态</text></view><app-icon name="arrow-right" size="34" color="#89918e" /></view>
</view>
